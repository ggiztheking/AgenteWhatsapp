# Claude
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > Configuración de la API)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Texto que tú inventas; pégalo también en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=un-texto-secreto
# App Secret de tu app de Meta, para verificar la firma de cada webhook (muy recomendado)
WHATSAPP_APP_SECRET=

# Tu número personal (con código de país, sin + ni espacios; en México 52 + 10 dígitos). Recibe los avisos.
DUENO_TELEFONO=529991234567

# Agenda de barberia-saas (la misma de la página web). Con BARBERIA_URL las citas se consultan y se
# reservan ahí, con barberos, y no se empalman con las de la página. Vacía = agenda local de agenda.json.
BARBERIA_URL=https://tu-app.up.railway.app
BARBERIA_SLUG=estilo-internacional

# Plantillas aprobadas en Meta (ver README). Vacías = desactivadas.
# Aviso al dueño cuando pasaron más de 24 h desde su último mensaje (sin variables).
WHATSAPP_PLANTILLA_AVISO=
# Recordatorio con confirmación el día anterior a la cita ({{1}} nombre, {{2}} servicio, {{3}} día y hora).
WHATSAPP_PLANTILLA_RECORDATORIO=
# Si no contesta el recordatorio en 4 h, se le insiste una vez (mismas variables). Vacía = solo si su ventana de 24 h está abierta.
WHATSAPP_PLANTILLA_SEGUIMIENTO=
# Lista de espera: aviso de lugar liberado ({{1}} nombre, {{2}} día, {{3}} horarios libres).
WHATSAPP_PLANTILLA_LUGAR_LIBRE=
WHATSAPP_IDIOMA_PLANTILLAS=es_MX

# Hora a la que te llega el resumen del día con métricas (ej. 23:15). Vacío = no se envía.
RESUMEN_DIARIO_HORA=23:15

# URL pública de este servidor (para que Mercado Pago avise cuando pagan un anticipo)
URL_PUBLICA=

# Opcional: anticipo por Mercado Pago al agendar (porcentaje del total de la cita)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SENA_PORCENTAJE=30
MONEDA=MXN

# Opcional: copiar cada turno a Google Calendar (cuenta de servicio, JSON en una sola línea)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Opcional: entender audios (transcripción con OpenAI)
OPENAI_API_KEY=

PORT=3000
DB_PATH=data/agente.db
TZ=America/Merida

# Solo para un servidor propio con docker-compose (Akamai Cloud). Vacío = deploy/instalar.sh usa <ip>.sslip.io
DOMINIO=
