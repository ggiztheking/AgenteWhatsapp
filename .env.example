# Claude
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > Configuración de la API)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Texto que vos inventás; lo pegás también en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=un-texto-secreto
# App Secret de tu app de Meta, para verificar la firma de cada webhook (muy recomendado)
WHATSAPP_APP_SECRET=

# Tu número personal (con código de país, sin + ni espacios). Recibe avisos de pedidos y derivaciones.
DUENO_TELEFONO=5491112345678

# Plantillas aprobadas en Meta (ver README). Vacías = desactivadas.
# Aviso al dueño cuando pasaron más de 24 h desde su último mensaje (sin variables).
WHATSAPP_PLANTILLA_AVISO=
# Recordatorio al cliente el día anterior al turno ({{1}} nombre, {{2}} servicio, {{3}} día y hora).
WHATSAPP_PLANTILLA_RECORDATORIO=
WHATSAPP_IDIOMA_PLANTILLAS=es_AR

# Hora a la que te llega el resumen del día con métricas (ej. 20:00). Vacío = no se envía.
RESUMEN_DIARIO_HORA=20:00

# URL pública del servidor (para que Mercado Pago avise cuando pagan una seña)
URL_PUBLICA=

# Opcional: seña por Mercado Pago al agendar (usa los precios de agenda.json)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SENA_PORCENTAJE=30

# Opcional: copiar cada turno a Google Calendar (cuenta de servicio, JSON en una sola línea)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Opcional: entender audios (transcripción con OpenAI)
OPENAI_API_KEY=

PORT=3000
DB_PATH=data/agente.db
TZ=America/Argentina/Buenos_Aires
