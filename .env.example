# Claude
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > Configuración de la API)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Texto que vos inventás; lo pegás también en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=un-texto-secreto
# Opcional: App Secret de tu app de Meta, para verificar la firma de cada webhook
WHATSAPP_APP_SECRET=

# Tu número personal (con código de país, sin + ni espacios). Recibe avisos de pedidos y derivaciones.
DUENO_TELEFONO=5491112345678

# Opcional: hora a la que te llega el resumen del día con métricas (ej. 20:00). Vacío = no se envía.
RESUMEN_DIARIO_HORA=20:00

PORT=3000
DB_PATH=data/agente.db
TZ=America/Argentina/Buenos_Aires
